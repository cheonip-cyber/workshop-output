{
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/rooms",
      "destination": "/api/court?route=rooms"
    },
    {
      "source": "/api/rooms/:path*",
      "destination": "/api/court?route=rooms/:path*"
    },
    {
      "source": "/join/:code",
      "destination": "/index.html"
    },
    {
      "source": "/display/:code",
      "destination": "/index.html"
    }
  ]
}
